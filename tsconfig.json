{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    // The SDK types mark the legacy api.command API optional, but the host
    // always provides it at runtime (the live plugin uses it). Sources are
    // kept byte-identical to the working plugin, so null strictness is
    // relaxed here instead of editing them. New code must still guard nulls.
    "strictNullChecks": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
