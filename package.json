{
  "name": "oc-go-usage-display",
  "version": "1.1.0",
  "description": "OpenCode Go subscription usage opencode-plugin: go_usage tool (server) and Go Usage sidebar panel + session_prompt_right statusline (TUI).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./kilo-tui": {
      "import": "./dist/kilo-tui.js",
      "types": "./dist/kilo-tui.d.ts"
    },
    "./package.json": "./package.json"
  },
  "oc-plugin": [
    "server",
    "tui",
    "kilo-tui"
  ],
  "bin": {
    "oc-go-usage-display-init": "bin/oc-go-usage-display-init.js",
    "oc-go-usage-display-remove": "bin/oc-go-usage-display-remove.js",
    "oc-go-usage-display-show": "bin/oc-go-usage-display-show.js",
    "oc-go-usage-display-status": "bin/oc-go-usage-display-status.js",
    "oc-go-usage-display-update": "bin/oc-go-usage-display-update.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophkroeppl/oc-go-usage-display.git"
  },
  "keywords": [
    "opencode",
    "opencode-go",
    "kilocode",
    "plugin",
    "usage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "opencode": "^1.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run build:plugins",
    "build:plugins": "bun run scripts/build-plugins.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "test": "bun run build && bun run test:unit && bun run test:integration",
    "test:unit": "bun test test/unit/*.test.js",
    "test:integration": "bun test test/integration/*.test.js",
    "test:e2e": "bun test test/e2e/*.test.js"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "@kilocode/plugin": "^7.4.0",
    "@opentui/solid": "0.5.11",
    "solid-js": "1.9.12"
  },
  "peerDependenciesMeta": {
    "@kilocode/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@kilocode/plugin": "^7.7.5",
    "@opentui/solid": "0.5.11",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.15",
    "typescript": "^6.0.3"
  }
}
